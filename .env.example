# Voice Assistant Environment Variables

# FREE AI PROVIDER OPTIONS (choose one or more):

# 1. GROQ - Fast & Free (Recommended)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Hugging Face - Free (Good for experimentation)
# Get your API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# 3. OpenRouter - Free Tier Available
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Ollama - Completely Free (Local)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# No API key needed - runs locally

# WAKE WORD DETECTION (Optional)
# For advanced wake word detection with Porcupine (Free tier available)
# Get your access key from: https://console.picovoice.ai/
# Leave blank to use simple wake word detection instead
PORCUPINE_ACCESS_KEY=your_porcupine_access_key_here

# PAID OPTIONS:

# DeepSeek API Key
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API Key (if you want to switch back)
# OPENAI_API_KEY=your_openai_api_key_here
